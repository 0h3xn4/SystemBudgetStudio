{
  "$defs": {
    "ProvenanceEntry": {
      "additionalProperties": false,
      "description": "The source of one input (or, under `*`, of every input without an entry of its own).",
      "properties": {
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "status": {
          "default": "sourced",
          "enum": [
            "sourced",
            "estimate",
            "illustrative",
            "tbd"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "source"
      ],
      "title": "ProvenanceEntry",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A spacecraft mode maps unit ids (file names in units/) to one of their power modes.",
  "properties": {
    "assignments": {
      "additionalProperties": {
        "type": "string"
      },
      "minProperties": 1,
      "title": "Assignments",
      "type": "object"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "kind": {
      "const": "spacecraft_mode",
      "default": "spacecraft_mode",
      "title": "Kind",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "provenance": {
      "additionalProperties": {
        "$ref": "#/$defs/ProvenanceEntry"
      },
      "title": "Provenance",
      "type": "object"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "assignments",
    "kind",
    "name",
    "schema_version"
  ],
  "title": "System Budget Studio spacecraft_mode",
  "type": "object"
}
