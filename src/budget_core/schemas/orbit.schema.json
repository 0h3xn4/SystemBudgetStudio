{
  "$defs": {
    "Elements": {
      "additionalProperties": false,
      "description": "Mean orbital elements, used as SGP4 mean elements without drag (DEVIATIONS DV-E2).",
      "properties": {
        "arg_perigee_deg": {
          "exclusiveMaximum": 360,
          "minimum": 0,
          "title": "Arg Perigee Deg",
          "type": "number"
        },
        "eccentricity_ratio": {
          "exclusiveMaximum": 1,
          "minimum": 0,
          "title": "Eccentricity Ratio",
          "type": "number"
        },
        "epoch_utc": {
          "title": "Epoch Utc",
          "type": "string"
        },
        "inclination_deg": {
          "maximum": 180,
          "minimum": 0,
          "title": "Inclination Deg",
          "type": "number"
        },
        "mean_anomaly_deg": {
          "exclusiveMaximum": 360,
          "minimum": 0,
          "title": "Mean Anomaly Deg",
          "type": "number"
        },
        "raan_deg": {
          "exclusiveMaximum": 360,
          "minimum": 0,
          "title": "Raan Deg",
          "type": "number"
        },
        "semi_major_axis_m": {
          "maximum": 100000000.0,
          "minimum": 6400000.0,
          "title": "Semi Major Axis M",
          "type": "number"
        }
      },
      "required": [
        "epoch_utc",
        "semi_major_axis_m",
        "eccentricity_ratio",
        "inclination_deg",
        "raan_deg",
        "arg_perigee_deg",
        "mean_anomaly_deg"
      ],
      "title": "Elements",
      "type": "object"
    },
    "ProvenanceEntry": {
      "additionalProperties": false,
      "description": "The source of one input (or, under `*`, of every input without an entry of its own).",
      "properties": {
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "status": {
          "default": "sourced",
          "enum": [
            "sourced",
            "estimate",
            "illustrative",
            "tbd"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "source"
      ],
      "title": "ProvenanceEntry",
      "type": "object"
    },
    "StateVector": {
      "additionalProperties": false,
      "description": "An orbit given as a position and a velocity at an epoch (D-229). The scenario propagates the\nmean elements whose SGP4 state at the epoch this is. `frame` says what the numbers are in:\n`j2000` (the mean equator and equinox of J2000) or `teme` (what SGP4 works in); it has no\ndefault, because the two differ by up to a degree.",
      "properties": {
        "epoch_utc": {
          "title": "Epoch Utc",
          "type": "string"
        },
        "frame": {
          "enum": [
            "j2000",
            "teme"
          ],
          "title": "Frame",
          "type": "string"
        },
        "position_m": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Position M",
          "type": "array"
        },
        "velocity_m_s": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Velocity M S",
          "type": "array"
        }
      },
      "required": [
        "epoch_utc",
        "frame",
        "position_m",
        "velocity_m_s"
      ],
      "title": "StateVector",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "elements": {
      "anyOf": [
        {
          "$ref": "#/$defs/Elements"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "kind": {
      "const": "orbit",
      "default": "orbit",
      "title": "Kind",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "provenance": {
      "additionalProperties": {
        "$ref": "#/$defs/ProvenanceEntry"
      },
      "title": "Provenance",
      "type": "object"
    },
    "schema_version": {
      "const": 3,
      "default": 3,
      "title": "Schema Version",
      "type": "integer"
    },
    "state": {
      "anyOf": [
        {
          "$ref": "#/$defs/StateVector"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "tle": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tle"
    }
  },
  "required": [
    "kind",
    "name",
    "schema_version"
  ],
  "title": "System Budget Studio orbit",
  "type": "object"
}
